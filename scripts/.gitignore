# ============================================================
# Dataset files
# ============================================================

# Raw datasets
data/raw/*

# Keep dataset directory structure
!data/raw/
!data/raw/email/
!data/raw/url/
!data/raw/threat_intelligence/
!data/raw/benchmarks/

# Intermediate/generated datasets
data/interim/*
data/processed/*

# Keep metadata and documentation
!data/metadata/
