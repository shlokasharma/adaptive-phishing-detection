# ==============================================================================
# Adaptive Phishing Detection System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the required settings.
# NEVER commit your actual .env file or real API keys to version control!

# ------------------------------------------------------------------------------
# Threat Intelligence Configuration (Phase 8)
# ------------------------------------------------------------------------------
# Enable or disable external threat intelligence lookups.
# Default is false to strictly prevent unauthorized/unexpected network traffic.
THREAT_INTEL_ENABLED=false

# VirusTotal API v3 Key (https://www.virustotal.com/)
# Optional: Required only if VirusTotal reputation lookups are enabled.
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing Lookup API v4 Key (https://developers.google.com/safe-browsing/)
# Optional: Required only if Google Safe Browsing lookups are enabled.
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# Local Offline Reputation Provider (zero network calls, zero API keys required)
# Default is true to allow deterministic local reputation lookups offline.
LOCAL_REPUTATION_ENABLED=true

# Provider HTTP request timeout in seconds
THREAT_INTEL_TIMEOUT_SECONDS=4.0

# In-memory cache time-to-live in seconds (default: 3600 = 1 hour)
THREAT_INTEL_CACHE_TTL_SECONDS=3600

# In-memory cache maximum capacity (LRU eviction)
THREAT_INTEL_CACHE_MAX_SIZE=1000

# ------------------------------------------------------------------------------
# Optional Cloud LLM Reasoning Configuration (Phase 7)
# ------------------------------------------------------------------------------
# Optional Cloud LLM API key (strictly disabled by default in code).
PHISHING_DETECTION_LLM_KEY=your_optional_llm_key_here
